# ── Base de datos ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGODB_DB_NAME=chapter_nineteen

# ── Autenticación ────────────────────────────────────────────
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-string-random-largo

# ── Cloudinary (imágenes) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Seed inicial del SuperAdmin (solo para db:seed) ──────────
SEED_ADMIN_USER=admin
SEED_ADMIN_EMAIL=admin@chapternineteen.store
SEED_ADMIN_PASSWORD=cambia-esta-password
